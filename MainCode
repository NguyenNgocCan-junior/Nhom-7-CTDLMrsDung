// ---------- Cau truc mot nut cua cay Trie ----------
struct TrieNode {
    TrieNode* con[128];   // mang con tro: moi o ung voi 1 ky tu (ma ASCII)
    bool laTu;            // true neu day la ky tu cuoi cua mot tu
    string nghia;         // nghia tieng Viet cua tu
    string loaiTu;        // loai tu: noun, verb, adj... (co the de trong)
    string viDu;          // cau vi du (co the de trong)
    string dongNghia;     // cac tu dong nghia, ngan cach bang dau phay (co the de trong)
    string traiNghia;     // cac tu trai nghia, ngan cach bang dau phay (co the de trong)

    TrieNode() {
        for (int i = 0; i < 128; i++) {
            con[i] = NULL;
        }
        laTu = false;
        nghia = "";
        loaiTu = "";
        viDu = "";
        dongNghia = "";
        traiNghia = "";
    }
};

TrieNode* goc = new TrieNode();   // nut goc cua cay
int tongSoTu = 0;                 // so tu hien co trong tu dien

// ---------- Doi chu hoa thanh chu thuong ----------
string chuThuong(string s) {
    for (int i = 0; i < s.size(); i++) {
        if (s[i] >= 'A' && s[i] <= 'Z') {
            s[i] = s[i] + 32;
        }
    }
    return s;
}

// ---------- Tim nut ung voi mot chuoi (khong thay thi tra ve NULL) ----------
TrieNode* timNut(string s) {
    TrieNode* p = goc;
    for (int i = 0; i < s.size(); i++) {
        int c = s[i];
        if (c < 0 || c > 127) return NULL;    // ky tu la thi bo qua
        if (p->con[c] == NULL) return NULL;   // khong co nhanh nay
        p = p->con[c];
    }
    return p;
}

// ---------- Them tu vao cay (hoac sua nghia neu tu da co) ----------
void themTu(string tu, string nghia, string loaiTu = "", string viDu = "", string dongNghia = "", string traiNghia = "") {
    TrieNode* p = goc;
    for (int i = 0; i < tu.size(); i++) {
        int c = tu[i];
        if (c < 0 || c > 127) return;         // chi nhan chu cai tieng Anh
        if (p->con[c] == NULL) {
            p->con[c] = new TrieNode();       // chua co thi tao nut moi
        }
        p = p->con[c];
    }
    if (p->laTu == false) {
        tongSoTu++;                           // la tu moi
    }
    p->laTu = true;
    p->nghia = nghia;
    p->loaiTu = loaiTu;
    p->viDu = viDu;
    p->dongNghia = dongNghia;
    p->traiNghia = traiNghia;
}

// ---------- Doc file dictionary.txt ----------
// Moi dong: tu|nghia|loai tu|vi du|dong nghia|trai nghia
// (chi can tu|nghia la du, cac phan sau co the bo trong; dong nghia/trai nghia ngan cach bang dau phay)
// Cat khoang trang o hai dau chuoi
string catKhoang(string s) {
    while (!s.empty() && (s[s.size() - 1] == ' ' || s[s.size() - 1] == '\r' || s[s.size() - 1] == '\t')) s.erase(s.size() - 1);
    int i = 0;
    while (i < s.size() && (s[i] == ' ' || s[i] == '\t')) i++;
    return s.substr(i);
}

// Tra ve so tu doc duoc, hoac -1 neu khong mo duoc file
int docFile(string tenFile) {
    ifstream f(tenFile.c_str());
    if (!f.is_open()) return -1;
    string dong;
    int dem = 0;
    bool dau = true;
    while (getline(f, dong)) {
        // bo ky tu BOM (UTF-8) o dau file va ky tu xuong dong '\r' cua Windows
        if (dau && dong.size() >= 3 && dong.substr(0, 3) == "\xEF\xBB\xBF") dong = dong.substr(3);
        dau = false;
        while (!dong.empty() && (dong[dong.size() - 1] == '\r' || dong[dong.size() - 1] == ' ')) dong.erase(dong.size() - 1);
        if (dong == "" || dong[0] == '#') continue;      // bo qua dong trong va dong ghi chu
        // tach dong thanh toi da 6 phan theo dau '|' (phan cuoi lay het phan con lai)
        string phan[6];
        int n = 0;
        size_t bd = 0;
        while (n < 5) {
            size_t vt = dong.find('|', bd);
            if (vt == string::npos) break;
            phan[n++] = catKhoang(dong.substr(bd, vt - bd));
            bd = vt + 1;
        }
        phan[n++] = catKhoang(dong.substr(bd));

        string tu = chuThuong(phan[0]);
        if (n >= 2 && tu != "") {
            themTu(tu, phan[1], n > 2 ? phan[2] : "", n > 3 ? phan[3] : "",
                   n > 4 ? phan[4] : "", n > 5 ? phan[5] : "");
            dem++;
        }
    }
    return dem;
}

// ---------- Xoa tu (chi bo danh dau, khong xoa nut) ----------
bool xoaTu(string tu) {
    TrieNode* p = timNut(tu);
    if (p == NULL || p->laTu == false) {
        return false;
    }
    p->laTu = false;
    p->nghia = "";
    p->loaiTu = "";
    p->viDu = "";
    p->dongNghia = "";
    p->traiNghia = "";
    tongSoTu--;
    return true;
}

// ---------- DFS: lay tat ca cac tu di qua nut p ----------
// hienTai la chuoi ghep tu goc den nut p
void duyetDFS(TrieNode* p, string hienTai, vector<string>& dsTu, vector<string>& dsNghia) {
    if (p == NULL) return;
    if (p->laTu) {
        dsTu.push_back(hienTai);
        dsNghia.push_back(p->nghia);
    }
    for (int i = 0; i < 128; i++) {
        if (p->con[i] != NULL) {
            duyetDFS(p->con[i], hienTai + (char)i, dsTu, dsNghia);
        }
    }
}

// ---------- De quy giai phong toan bo cay ----------
void giaiPhong(TrieNode* p) {
    if (p == NULL) return;
    for (int i = 0; i < 128; i++) {
        giaiPhong(p->con[i]);
    }
    delete p;
}

// ---------- Dinh dang 1 tu de hien thi: tu (loai tu) : nghia + dong vi du ----------
string chiTietTu(string tu, TrieNode* p) {
    string kq = tu;
    if (p->loaiTu != "") kq += " (" + p->loaiTu + ")";
    kq += " : " + p->nghia;
    if (p->viDu != "") kq += "\n   Vi du: " + p->viDu;
    if (p->dongNghia != "") kq += "\n   Dong nghia: " + p->dongNghia;
    if (p->traiNghia != "") kq += "\n   Trai nghia: " + p->traiNghia;
    return kq;
}

// ---------- Goi y khi go sai chinh ta: khoang cach chinh sua (Levenshtein) ----------
// So buoc it nhat (them / xoa / doi 1 ky tu) de bien chuoi a thanh chuoi b
int khoangCachSua(string a, string b) {
    vector<int> truoc(b.size() + 1), hien(b.size() + 1);
    for (int j = 0; j <= b.size(); j++) truoc[j] = j;
    for (int i = 1; i <= a.size(); i++) {
        hien[0] = i;
        for (int j = 1; j <= b.size(); j++) {
            int doi = truoc[j - 1] + (a[i - 1] == b[j - 1] ? 0 : 1);
            hien[j] = min(min(hien[j - 1] + 1, truoc[j] + 1), doi);
        }
        truoc = hien;
    }
    return truoc[b.size()];
}

// Tra ve toi da 3 tu gan giong nhat, ngan cach bang dau phay ("" neu khong co tu nao)
string chuoiGanDung(string tu) {
    vector<string> dsTu, dsNghia;
    duyetDFS(goc, "", dsTu, dsNghia);

    int nguong = (tu.size() <= 4) ? 1 : 2;      // tu ngan thi chi cho sai 1 ky tu
    vector<pair<int, string> > kq;
    for (int i = 0; i < dsTu.size(); i++) {
        int chenh = (int)dsTu[i].size() - (int)tu.size();
        if (chenh > nguong || chenh < -nguong) continue;      // do dai lech nhieu thi bo qua
        int d = khoangCachSua(tu, dsTu[i]);
        if (d > 0 && d <= nguong) {
            int chung = 0;                       // so ky tu dau giong nhau (cang nhieu cang uu tien)
            while (chung < tu.size() && chung < dsTu[i].size() && tu[chung] == dsTu[i][chung]) chung++;
            kq.push_back(make_pair(d * 100 - chung, dsTu[i]));
        }
    }
    sort(kq.begin(), kq.end());                  // gan nhat truoc, bang nhau thi theo a-z

    string s = "";
    for (int i = 0; i < kq.size() && i < 3; i++) {
        if (i > 0) s += ", ";
        s += kq[i].second;
    }
    return s;
}

// Thong bao khong tim thay, kem goi y neu co tu gan giong
string thongBaoKhongThay(string tu) {
    string s = "Khong tim thay tu \"" + tu + "\"";
    string g = chuoiGanDung(tu);
    if (g != "") s += "\n   Co phai ban muon tim: " + g + " ?";
    return s;
}

// ---------- Luu toan bo tu dien ra dictionary.txt ----------
// Dong dau tien la dong ghi chu (bat dau bang '#'), khi doc file se bi bo qua
const string DONG_TIEU_DE = "# TU DIEN ANH-VIET";

string boDauGach(string s) {          // dau '|' dung de ngan cach nen doi sang '/' khi ghi file
    for (int i = 0; i < s.size(); i++) {
        if (s[i] == '|') s[i] = '/';
    }
    return s;
}

bool luuTuDien() {
    ofstream f("dictionary.txt");
    if (!f.is_open()) return false;

    f << DONG_TIEU_DE << " (moi dong: tu|nghia|loai tu|vi du|dong nghia|trai nghia)" << "\n";
    vector<string> dsTu, dsNghia;
    duyetDFS(goc, "", dsTu, dsNghia);
    for (int i = 0; i < dsTu.size(); i++) {
        TrieNode* p = timNut(dsTu[i]);
        f << dsTu[i] << "|" << boDauGach(p->nghia) << "|" << boDauGach(p->loaiTu) << "|" << boDauGach(p->viDu)
          << "|" << boDauGach(p->dongNghia) << "|" << boDauGach(p->traiNghia) << "\n";
    }
    return f.good();
}

void thongBaoLuu() {
    if (luuTuDien()) {
        cout << "  (da luu vao dictionary.txt)" << endl;
    } else {
        cout << "  (khong ghi duoc dictionary.txt, thay doi chi co hieu luc den khi thoat)" << endl;
    }
}



