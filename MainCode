// Doc 1 phim ngay khi bam, khong can Enter. Phim mui ten, F1... tra ve 0 (bo qua)
int docPhim() {
#ifdef _WIN32
    int phim = _getch();
    if (phim == 0 || phim == 224) {
        _getch();
        return 0;
    }
    return phim;
#else
    termios cu, moi;
    tcgetattr(STDIN_FILENO, &cu);          // luu cai dat terminal cu
    moi = cu;
    moi.c_lflag &= ~(ICANON | ECHO);       // tat che do cho Enter va tat hien phim
    moi.c_cc[VMIN] = 1;
    moi.c_cc[VTIME] = 0;
    tcsetattr(STDIN_FILENO, TCSANOW, &moi);

    unsigned char c = 0;
    read(STDIN_FILENO, &c, 1);             // doc 1 phim
    int phim = c;

    if (phim == 27) {                      // ESC that, hay la phim mui ten (ESC [ A)?
        moi.c_cc[VMIN] = 0;
        moi.c_cc[VTIME] = 1;               // cho toi da 0.1 giay xem co ky tu di kem khong
        tcsetattr(STDIN_FILENO, TCSANOW, &moi);
        unsigned char tiep;
        if (read(STDIN_FILENO, &tiep, 1) > 0) {
            while (read(STDIN_FILENO, &tiep, 1) > 0) { }   // bo not phan con lai
            phim = 0;                      // phim mui ten -> bo qua
        }
    }

    tcsetattr(STDIN_FILENO, TCSANOW, &cu); // tra terminal ve nhu cu
    return phim;
#endif
}
// ---------- Lich su tra cuu & danh sach tu can ghi nho ----------
vector<string> lichSu;        // cac tu da tra (tu cu den moi)
vector<string> canGhiNho;      // cac tu can ghi nho (luu trong file canghinho.txt)

void ghiLichSu(string tu) {
    if (lichSu.size() > 0 && lichSu[lichSu.size() - 1] == tu) return;   // tranh ghi trung lien tiep
    lichSu.push_back(tu);
}

int viTriGhiNho(string tu) {
    for (int i = 0; i < canGhiNho.size(); i++) {
        if (canGhiNho[i] == tu) return i;
    }
    return -1;
}

void luuGhiNho() {
    ofstream f("canghinho.txt");
    for (int i = 0; i < canGhiNho.size(); i++) {
        f << canGhiNho[i] << endl;
    }
}

void docGhiNho() {
    ifstream f("canghinho.txt");
    string dong;
    while (getline(f, dong)) {
        while (!dong.empty() && (dong[dong.size() - 1] == '\r' || dong[dong.size() - 1] == ' ')) dong.erase(dong.size() - 1);
        if (dong != "" && viTriGhiNho(dong) < 0) canGhiNho.push_back(dong);
    }
}

// Tra ve 1: da them, 0: da co san trong danh sach, -1: khong phai tu trong tu dien
int themGhiNho(string tu) {
    TrieNode* p = timNut(tu);
    if (p == NULL || p->laTu == false) return -1;
    if (viTriGhiNho(tu) >= 0) return 0;
    canGhiNho.push_back(tu);
    luuGhiNho();
    return 1;
}

string thongBaoGhiNho(string tu) {
    int kq = themGhiNho(tu);
    if (kq == 1) return ">> Da luu \"" + tu + "\" vao danh sach can ghi nho";
    if (kq == 0) return ">> \"" + tu + "\" da co trong danh sach can ghi nho";
    return ">> Chi luu duoc tu co trong tu dien";
}


